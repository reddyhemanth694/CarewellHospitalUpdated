# Copy this file to .env for local use (never commit the real .env).
# On Render, add these under Environment > Environment Variables.

CAREWELL_DB_URL=jdbc:mysql://localhost:3306/carewell_hospital
CAREWELL_DB_USER=your_mysql_user
CAREWELL_DB_PASSWORD=your_mysql_password

CAREWELL_EMAIL=your_sender_email@example.com
BREVO_API_KEY=your_brevo_api_key
